@@ -0,0 +1,61 @@
+"""Точные показатели и детерминированный текст отчёта."""
+
+from decimal import MAX_EMAX, MIN_EMIN, Decimal, localcontext
+
+
+def summarize(clean_rows, categories):
+    amounts = [Decimal(row["amount"]) for row in clean_rows]
+    # Сохраняем все десятичные разряды даже при сумме длиннее контекста Decimal.
+    if amounts:
+        highest = max(amount.adjusted() for amount in amounts)
+        lowest = min(amount.as_tuple().exponent for amount in amounts)
+        precision = max(1, highest - lowest + 1 + len(str(len(amounts))))
+    else:
+        precision = 1
+    with localcontext() as context:
+        context.prec = precision
+        context.Emax = MAX_EMAX
+        context.Emin = MIN_EMIN
+        totals = {category: Decimal(0) for category in categories.values()}
+        for row, amount in zip(clean_rows, amounts):
+            totals[row["category"]] += amount
+        total = sum(amounts, Decimal(0))
+    return {"clean_rows": len(clean_rows), "total": total, "category_totals": totals}
+
+
+def render_report(clean_rows, stats, sources, rules):
+    summary = summarize(clean_rows, rules["categories"])
+    lines = ["# Отчёт", "", "## Источники"]
+    lines.extend("- " + source for source in sources)
+    if not sources:
+        lines.append("- Нет")
+    lines.extend(
+        [
+            "",
+            "## Показатели",
+            "- Уникальных операций: {}".format(summary["clean_rows"]),
+            "- Общая сумма: {} KZT".format(format(summary["total"], "f")),
+            "",
+            "| Категория | Сумма, KZT |",
+            "| --- | ---: |",
+        ]
+    )
+    for category, amount in summary["category_totals"].items():
+        lines.append("| {} | {} |".format(category, format(amount, "f")))
+    lines.extend(
+        [
+            "",
+            "## Баланс строк",
+            "- Исходных строк: {}".format(stats["source_rows"]),
+            "- Корректных уникальных строк: {}".format(stats["clean_rows"]),
+            "- Полных повторов: {}".format(stats["duplicate_rows"]),
+            "- Отклонённых строк: {}".format(stats["rejected_rows"]),
+            "",
+            "## Допущения",
+            "- Валидация предшествует исключению повторов: проверяются поля, реальная дата, категория и конечная неотрицательная сумма.",
+            "- Полный повтор совпадает по всем четырём исходным полям; повтор неверной записи отклоняется.",
+            "- При конфликте id с другими значениями сохраняется первая корректная запись, последующая отклоняется.",
+            "",
+        ]
+    )
+    return "\n".join(lines)

diff --git a/submissions/mairamaidan/SA04/src/verify.py b/submissions/mairamaidan/SA04/src/verify.py
new file mode 100644
index 0000000..a2284e9
--- /dev/null
+++ b/submissions/mairamaidan/SA04/src/verify.py
@@ -0,0 +1,157 @@
+"""Независимая сверка контрольного набора H07, не общий валидатор CSV."""
+
+import argparse
+import csv
+import json
+import sys
+from decimal import Decimal
+from pathlib import Path
+
+
+def read_csv(path, fields):
+    with path.open(encoding="utf-8", newline="") as stream:
+        reader = csv.DictReader(stream, strict=True)
+        if reader.fieldnames != fields:
+            raise ValueError(f"Неверная схема: {path}")
+        rows = list(reader)
+        if any(None in row or None in row.values() for row in rows):
+            raise ValueError(f"Неверная строка: {path}")
+        return rows
+
+
+def verify(input_dir, output_dir, expected_path):
+    expected = json.loads(expected_path.read_text(encoding="utf-8"))
+    rules = json.loads((input_dir / "rules.json").read_text(encoding="utf-8"))
+    fields = ["id", "date", "category", "amount"]
+    rejects = []
+    accepted = []
+    seen = set()
+    source_count = duplicates = 0
+    reasons = {
+        "A5": "Неверная дата",
+        "A6": "Неизвестная категория",
+        "A7": "Неверная сумма",
+    }
+    if set(expected["rejected_ids"]) != set(reasons):
+        raise ValueError("Неизвестный набор отклонений H07")
+    for name in ("nov-1.csv", "nov-2.csv"):
+        path = input_dir / name
+        with path.open(encoding="utf-8", newline="") as stream:
+            lines = stream.readlines()
+        reader = csv.reader(lines, strict=True)
+        if next(reader) != fields:
+            raise ValueError(f"Неверная схема: {path}")
+        while True:
+            start = reader.line_num + 1
+            try:
+                row = next(reader)
+            except StopIteration:
+                break
+            if len(row) != 4:
+                raise ValueError("Неизвестная строка H07")
+            source_count += 1
+            if row[0] in reasons:
+                defects = {
+                    "A5": (1, "bad-date"),
+                    "A6": (2, "Unknown"),
+                    "A7": (3, "-20"),
+                }
+                index, value = defects[row[0]]
+                if row[index] != value or (
+                    row[0] == "A6" and value in rules["categories"]
+                ):
+                    raise ValueError("Дефект отклонённой строки H07 изменён")
+                rejects.append(
+                    {
+                        "source": name,
+                        "line_number": str(start),
+                        "raw_line": "".join(lines[start - 1 : reader.line_num])
+                        .removesuffix("\n")
+                        .removesuffix("\r"),
+                        "id": row[0],
+                        "reason": reasons[row[0]],
+                    }
+                )
+            elif tuple(row) in seen:
+                duplicates += 1
+            else:
+                seen.add(tuple(row))
+                accepted.append(
+                    dict(
+                        zip(
+                            fields,
+                            [
+                                row[0],
+                                row[1],
+                                rules["categories"][row[2]],
+                                format(Decimal(row[3]), "f"),
+                            ],
+                        )
+                    )
+                )
+    clean = read_csv(output_dir / "clean.csv", fields)
+    rejected = read_csv(
+        output_dir / "rejected.csv",
+        ["source", "line_number", "raw_line", "id", "reason"],
+    )
+    if clean != accepted or len({row["id"] for row in clean}) != len(clean):
+        raise ValueError("Расхождение clean.csv")
+    if rejected != rejects or sorted(row["id"] for row in rejected) != sorted(
+        expected["rejected_ids"]
+    ):
+        raise ValueError("Расхождение rejected.csv")
+    counts = {
+        "source_rows": source_count,
+        "clean_rows": len(clean),
+        "duplicate_rows": duplicates,
+        "rejected_rows": len(rejected),
+    }
+    if any(counts[k] != expected[k] for k in counts) or source_count != len(
+        clean
+    ) + duplicates + len(rejected):
+        raise ValueError("Расхождение баланса")
+    totals = {category: Decimal(0) for category in rules["categories"].values()}
+    for row in clean:
+        totals[row["category"]] += Decimal(row["amount"])
+    if totals != {
+        k: Decimal(str(v)) for k, v in expected["category_totals"].items()
+    } or sum(totals.values()) != Decimal(str(expected["total"])):
+        raise ValueError("Расхождение контрольных сумм")
+    report = (output_dir / "report.md").read_text(encoding="utf-8").splitlines()
+    required = [
+        "- nov-1.csv",
+        "- nov-2.csv",
+        f"- Уникальных операций: {counts['clean_rows']}",
+        f"- Общая сумма: {expected['total']} KZT",
+        f"- Исходных строк: {source_count}",
+        f"- Корректных уникальных строк: {len(clean)}",
+        f"- Полных повторов: {duplicates}",
+        f"- Отклонённых строк: {len(rejected)}",
+    ]
+    required += [
+        f"| {category} | {amount} |"
+        for category, amount in expected["category_totals"].items()
+    ]
+    if any(report.count(line) != 1 for line in required):
+        raise ValueError("Расхождение report.md")
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Независимая проверка контрольного H07"
+    )
+    parser.add_argument("--input", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--expected", type=Path, required=True)
+    args = parser.parse_args()
+    try:
+        verify(args.input, args.output, args.expected)
+    except (OSError, ValueError, KeyError, TypeError, StopIteration, csv.Error) as exc:
+        print(f"Ошибка проверки H07: {exc}", file=sys.stderr)
+        return 1
+    print("Контрольный H07 проверен")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

